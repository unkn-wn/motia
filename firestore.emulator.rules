// Local Firestore emulator only. This file has never been deployed and must not be:
// it mirrors the production owner-only behaviour so automated tests run against the same access rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
