# Test mode (`vite --mode e2e`): overrides every Firebase key so the app talks only to the local emulator.
# No secrets. The `demo-` project id makes the Firebase tools refuse to reach a real project.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-motia.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-motia
VITE_FIREBASE_STORAGE_BUCKET=demo-motia.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_EMULATOR=1
